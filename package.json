{
  "name": "kadrowka_react",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24 <25" },
  "version": "0.1.0-beta.12",
  "type": "module",
  "scripts": {
    "content:sync": "node scripts/sync-content-transaction.mjs",
    "source:check": "node scripts/check-source-package.mjs",
    "content:sync:core": "node scripts/sync-content-core.mjs",
    "content:rollback": "node scripts/rollback-content-sync.mjs",
    "content:normalize": "node scripts/normalize-content-paths.mjs",
    "content:enrich": "node scripts/enrich-sharepoint-content.mjs",
    "content:tools": "node scripts/build-tools-catalog.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "content:catalog": "node scripts/build-materials-catalog.mjs",
    "content:audit:ssi": "node scripts/audit-ssi-duplicates.mjs",
    "content:files": "node scripts/sync-content-files.mjs",
    "content:android": "node scripts/sync-content-android.mjs",
    "icons:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-pwa-icons.ps1",
    "predev": "pnpm source:check && pnpm content:files && pnpm content:sync && pnpm content:validate",
    "dev": "vite",
    "prebuild": "pnpm source:check && pnpm content:files && pnpm content:sync && pnpm content:validate",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:exports": "node --experimental-strip-types scripts/export-smoke.mjs",
    "test:migration": "node scripts/migration-smoke.mjs",
    "test:imports": "node --experimental-strip-types scripts/import-security-smoke.mjs",
    "test:content-sync": "node scripts/content-sync-smoke.mjs",
    "test:pwa": "node scripts/pwa-smoke.mjs",
    "test:security": "node --experimental-strip-types scripts/security-smoke.mjs",
    "test:security:dependencies": "pnpm audit --prod",
    "test:visual": "node scripts/visual-regression.mjs",
    "test:visual:update": "node scripts/visual-regression.mjs --update",
    "test:deployment": "node scripts/deployment-smoke.mjs",
    "test:deployment:local": "node scripts/local-deployment-smoke.mjs",
    "test:materials:deployment": "node scripts/materials-deployment-audit.mjs",
    "test:materials:catalog": "node scripts/material-catalog-smoke.mjs",
    "test:admin": "node --experimental-strip-types scripts/admin-release-smoke.mjs",
    "test:source-image": "node scripts/source-image-repair-smoke.mjs",
    "deploy:prepare": "pnpm build && pnpm test:security && pnpm test:source-image && pnpm test:imports && pnpm test:content-sync && pnpm test:exports && pnpm test:migration && pnpm test:pwa && pnpm test:materials:catalog && pnpm test:admin && node scripts/prepare-web-deployment.mjs",
    "release:production": "pnpm deploy:prepare && pnpm audit --prod && node scripts/production-release-check.mjs && pnpm test:deployment:local",
    "preview": "vite preview",
    "preview:release": "node scripts/serve-release.mjs",
    "cap:sync": "pnpm build && cap sync",
    "cap:sync:full": "pnpm cap:sync && pnpm content:android",
    "android": "pnpm cap:sync && cap open android",
    "android:full": "pnpm cap:sync:full && cap open android"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.20.0",
    "@azure/storage-blob": "^12.33.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "docx": "^9.7.1",
    "dompurify": "3.4.17",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}
